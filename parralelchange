#!/usr/bin/zsh
##############################################################################
#
# Script:   maxjob_refresh
#
# Summary:  Runs the child scripts strictly one-by-one, in the order listed in
#           SCRIPT_LIST, and updates the control table (PROCESS_STATUS):
#               W = Waiting, R = Running, S = Success, F = Failed
#           A fresh run first sets every script to W, then runs them in order.
#           In restart mode it skips scripts already at S and carries on from
#           the one that failed. Sends a mail when everything finishes
#           (and a failure mail if any script fails).
#
# Run:      nohup ./maxjob_refresh &                  FRESH run: sets ALL scripts to
#                                                     W first, then runs them 1..N
#           nohup ./maxjob_refresh restart &          RESTART: skips scripts already
#                                                     at S, continues from the failed one
#           nohup ./maxjob_refresh restart 20261112 & RESTART of an earlier day's batch
#
# WHO            WHEN         MODIFICATION HISTORY (most recent first)
#
# <your name>    <dd/mm/yyyy> Initial
# ----------------------------------------------------------------------------
##############################################################################

. ${AIGWRAPPER}/UtilityFuncs
. ${AIGWRAPPER}/XUtilityFuncs

# To generate shell debug info to the console log, uncomment next line
#set -xv

# ---------------------------------------------------------------------------
# nohup-safety: ignore hangup, never wait on a terminal, and do not leave the
# 'no matches' error of zsh when a wildcard matches nothing
# ---------------------------------------------------------------------------
trap '' HUP
trap 'exit 143' TERM INT
setopt NULL_GLOB
exec < /dev/null

# Run mode: (none) = fresh run, "restart" = continue from the failed script
RUN_MODE=${1:-fresh}
case "${RUN_MODE}" in
    fresh|restart) ;;
    *) echo "ERROR: unknown argument '${RUN_MODE}'. Use no argument (fresh) or 'restart'"; exit 1 ;;
esac

# Batch id = today's date, unless given as 2nd argument (restart of an earlier day)
BATCH_ID=${2:-$(date +"%Y%m%d")}
case "${BATCH_ID}" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
    *) echo "ERROR: batch id '${BATCH_ID}' must be YYYYMMDD"; exit 1 ;;
esac

# ---------------------------------------------------------------------------
# Locations (logs go to /sawork/sauat/tmp)
# ---------------------------------------------------------------------------
LOG_FILE_LOC=/sawork/sauat/tmp
LOG=${LOG_FILE_LOC}/maxjob_refresh_${BATCH_ID}.log   # needed by fnLog/fnXCmd in UtilityFuncs
SCRIPT_DIR=/sawork/sauat/wrapper     # folder where the child scripts are

months=(Zero January February March April May June July August September October November December)
curr_month=$(date -d "$(date +%Y-%m-15) -2 month" +%-m)
month=${months[${curr_month}+1]}
vMailList=shashank.jain@aig.com,bipin.pathak@aig.com
#vMailList=shashank.jain@aig.com

mkdir -p ${LOG_FILE_LOC} && chmod 755 ${LOG_FILE_LOC}

# Everything the master script prints goes to its own log (not nohup.out)
MASTER_LOG=${LOG}
exec >> ${MASTER_LOG} 2>&1

echo "=== Starting Master Script $(date) | batch ${BATCH_ID} ==="

# ---------------------------------------------------------------------------
# Control table settings  -  CHECK THESE AGAINST:  DESC <table>;
# ---------------------------------------------------------------------------
CTRL_TABLE="sadb.production_control"   # use the exact schema.table of your environment
DB_CONN_ID=110                         # same id you pass to fnXCmd in the original script

COL_SCRIPT="PROCESS_ID"       # column holding the script/job name
COL_STATUS="PROCESS_STATUS"    # column holding W / R / S / F
COL_BATCH=""                    # batch/date column. "" = table has none
COL_TS="LAST_UPD_TS"           # last-updated timestamp column. Set to "" if none

# ---------------------------------------------------------------------------
# Scripts to run, in order.
#
# STAGES: ALL scripts that start with the same prefix (the text before the
# first "_", e.g. Max1) form ONE stage and run IN PARALLEL, wherever they are
# in the list. Stages run in the order their prefix first appears below, and a
# stage starts only when the previous stage has finished and ALL its scripts
# succeeded.
# So below:  Max1_* (all in parallel) -> Max2_* -> Max3_*
#
# To add a script: just add its name to this list.
# ---------------------------------------------------------------------------
SCRIPT_LIST=(
    "Max1_aiu_hist_proc"
    "Max1_3a_RecreateCRSBookedPrem_5YR"
    "Max1_8b1_Claims_incurred_20_yrs"
    "Max1_8c1_Claims_incurred_20_yrs"
    "Max2_RecreateKPI_Pre_364"
    "Max3_3b_RecreateCRSBookedPrem_5YR"
)

RUNNING_SCRIPTS=""      # names of the scripts that are running right now

# ---------------------------------------------------------------------------
# Update status of a script in the control table
#   usage: update_status <script_name> <W|R|S|F>
# Does an upsert (update if the row exists, insert if not).
# Uses only the columns set in COL_* above.
# ---------------------------------------------------------------------------
update_status() {
    local sname=$1
    local new_status=$2
    local on_cond="t.${COL_SCRIPT} = s.script_name"
    local upd_set="t.${COL_STATUS} = '${new_status}'"
    local ins_cols="${COL_SCRIPT}, ${COL_STATUS}"
    local ins_vals="s.script_name, '${new_status}'"

    if [ -n "${COL_BATCH}" ]; then
        on_cond="${on_cond} AND t.${COL_BATCH} = s.batch_id"
        ins_cols="${ins_cols}, ${COL_BATCH}"
        ins_vals="${ins_vals}, s.batch_id"
    fi
    if [ -n "${COL_TS}" ]; then
        upd_set="${upd_set}, t.${COL_TS} = SYSDATE"
        ins_cols="${ins_cols}, ${COL_TS}"
        ins_vals="${ins_vals}, SYSDATE"
    fi

    cmd="
    SET HEAD OFF FEED OFF PAGES 0
    MERGE INTO ${CTRL_TABLE} t
    USING (SELECT '${sname}' AS script_name, '${BATCH_ID}' AS batch_id FROM dual) s
       ON (${on_cond})
     WHEN MATCHED THEN
          UPDATE SET ${upd_set}
     WHEN NOT MATCHED THEN
          INSERT (${ins_cols})
          VALUES (${ins_vals});
    COMMIT;"
    fnXCmd ${DB_CONN_ID}

    if [ $? -ne 0 ]; then
        echo "WARNING: could not set ${sname} to ${new_status} in ${CTRL_TABLE}"
    else
        echo "${CTRL_TABLE}: ${sname} -> ${new_status}"
    fi
}

# ---------------------------------------------------------------------------
# Read the current status of a script from the control table (restart mode)
#   usage: get_status <script_name>     (prints W/R/S/F, or N if no row yet)
# ---------------------------------------------------------------------------
get_status() {
    local sname=$1
    local where="${COL_SCRIPT} = '${sname}'"

    if [ -n "${COL_BATCH}" ]; then
        where="${where} and ${COL_BATCH} = '${BATCH_ID}'"
    fi

    cmd="
    SET HEAD OFF FEED OFF PAGES 0
    select nvl(max(${COL_STATUS}),'N') from ${CTRL_TABLE} where ${where};"
    fnXCmd ${DB_CONN_ID}
    printf "%s\n" "${output}" | grep -E '^[A-Z]$' | head -1
}

# ---------------------------------------------------------------------------
# Send a failure mail (with the failed script's log attached)
#   usage: send_failure_mail <script_name> <return_code>
# ---------------------------------------------------------------------------
send_failure_mail() {
    local sname=$1
    local rcode=$2
    local logf=${LOG_FILE_LOC}/${sname}.log
    local errtail=""
    [ -f ${logf} ] && errtail=$(tail -20 ${logf})

    if [ -f ${logf} ]; then
        mailx -s "FAILED: maxjob_refresh (${month}) - ${sname} failed !" -a ${logf} ${vMailList} <<EOF
Hi,

The maxjob_refresh job for ${month} has FAILED.

Failed script : ${sname}
Return code   : ${rcode}
Batch ID      : ${BATCH_ID}
Log file      : ${logf} (attached)

Last lines of the log:
----------------------------------------
${errtail}
----------------------------------------

The master script has stopped. Remaining scripts were not run and are
still marked W in ${CTRL_TABLE}. Fix the problem and run the master script
again with the "restart" argument; it will continue from ${sname}.


Best regards,

KPI Support (email - kpi_support@aig.com )

EOF
    else
        mailx -s "FAILED: maxjob_refresh (${month}) - ${sname} failed !" ${vMailList} <<EOF
Hi,

The maxjob_refresh job for ${month} has FAILED.

Failed script : ${sname}
Return code   : ${rcode}
Batch ID      : ${BATCH_ID}
Log file      : not found at ${logf}

The master script has stopped. Remaining scripts were not run and are
still marked W in ${CTRL_TABLE}. Fix the problem and run the master script
again with the "restart" argument; it will continue from ${sname}.


Best regards,

KPI Support (email - kpi_support@aig.com )

EOF
    fi
}

# ---------------------------------------------------------------------------
# If the master script is killed (kill / TERM / INT) while a child script is
# running, mark that script as F so the table does not stay at R.
# ---------------------------------------------------------------------------
on_exit() {
    local n
    if [ -n "${RUNNING_SCRIPTS}" ]; then
        for n in $(echo ${RUNNING_SCRIPTS}); do
            echo "Master script terminated while ${n} was running"
            update_status "${n}" "F"
        done
        RUNNING_SCRIPTS=""
    fi
}
trap on_exit EXIT

# ---------------------------------------------------------------------------
# Run one script and wait for it to finish (foreground, so the next
# script cannot start until this one has completed)
# ---------------------------------------------------------------------------
run_script() {
    local script_name=$1
    local rc

    update_status "${script_name}" "R"
    RUNNING_SCRIPTS="${script_name}"
    echo ">>> Starting ${script_name}... $(date)"

    "${SCRIPT_DIR}/${script_name}" < /dev/null > ${LOG_FILE_LOC}/${script_name}.log 2>&1
    rc=$?        # capture the exit code immediately
    RUNNING_SCRIPTS=""

    # move any log the script wrote in its own folder
    if [ -f ${SCRIPT_DIR}/${script_name}.log ]; then
        mv -f ${SCRIPT_DIR}/${script_name}.log ${LOG_FILE_LOC}/${script_name}.wrapper.log
    fi

    if [ ${rc} -ne 0 ]; then
        update_status "${script_name}" "F"
        echo "${script_name} failed (rc=${rc}). Check ${LOG_FILE_LOC}/${script_name}.log"
        echo "---- last lines of ${script_name}.log ----"
        tail -20 ${LOG_FILE_LOC}/${script_name}.log
        echo "------------------------------------------"
        echo "Stopping master script."
        send_failure_mail "${script_name}" "${rc}"
        exit 1
    fi

    update_status "${script_name}" "S"
    echo "${script_name} completed successfully. $(date)"
}

# ---------------------------------------------------------------------------
# Run several scripts IN PARALLEL and wait until ALL of them have ended.
#   usage: run_parallel <script1> <script2> ...
# Every script gets its own R/S/F status and log. If any script fails, the
# others are still allowed to finish, then the master exits (nothing after
# this stage is started).
# ---------------------------------------------------------------------------
run_parallel() {
    local n p pid rc
    local pairs=()
    local pending=()
    local still=()
    local failed=()

    # 1) start ALL scripts first (no database call in between, so they all
    #    really start at the same time)
    for n in "$@"; do
        RUNNING_SCRIPTS="${RUNNING_SCRIPTS} ${n}"
        echo ">>> Starting ${n} (parallel)... $(date)"
        "${SCRIPT_DIR}/${n}" < /dev/null > ${LOG_FILE_LOC}/${n}.log 2>&1 &
        pairs+=("${n}:$!")
    done

    # 2) now mark them all as R in the control table
    for n in "$@"; do
        update_status "${n}" "R"
    done

    pending=("${pairs[@]}")
    while [ ${#pending[@]} -gt 0 ]; do
        still=()
        for p in "${pending[@]}"; do
            n=${p%%:*}
            pid=${p##*:}
            if kill -0 ${pid} 2>/dev/null; then
                still+=("${p}")
            else
                wait ${pid}
                rc=$?
                RUNNING_SCRIPTS=${RUNNING_SCRIPTS/ ${n}/}

                if [ -f ${SCRIPT_DIR}/${n}.log ]; then
                    mv -f ${SCRIPT_DIR}/${n}.log ${LOG_FILE_LOC}/${n}.wrapper.log
                fi

                if [ ${rc} -ne 0 ]; then
                    update_status "${n}" "F"
                    echo "${n} failed (rc=${rc}). Check ${LOG_FILE_LOC}/${n}.log"
                    echo "---- last lines of ${n}.log ----"
                    tail -20 ${LOG_FILE_LOC}/${n}.log
                    echo "------------------------------------------"
                    send_failure_mail "${n}" "${rc}"
                    failed+=("${n}")
                else
                    update_status "${n}" "S"
                    echo "${n} completed successfully. $(date)"
                fi
            fi
        done
        pending=("${still[@]}")
        [ ${#pending[@]} -gt 0 ] && sleep 5
    done

    if [ ${#failed[@]} -gt 0 ]; then
        echo "Stage failed: ${failed[*]}"
        echo "Stopping master script. Later scripts were not started."
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Step 0: pre-flight check. Before anything runs, confirm the scripts folder
#         exists and EVERY script in SCRIPT_LIST is there and executable.
#         Nothing is started (and the control table is untouched) if any fails.
# ---------------------------------------------------------------------------
echo "Scripts location: ${SCRIPT_DIR}"
if [ ! -d "${SCRIPT_DIR}" ]; then
    echo "ERROR: scripts folder ${SCRIPT_DIR} does not exist"
    exit 1
fi
cd ${SCRIPT_DIR} || { echo "ERROR: cannot cd to ${SCRIPT_DIR}"; exit 1; }

preflight_fail=0
for s in "${SCRIPT_LIST[@]}"; do
    if [ ! -f "${SCRIPT_DIR}/${s}" ]; then
        echo "ERROR: ${SCRIPT_DIR}/${s} not found"
        preflight_fail=1
    elif [ ! -x "${SCRIPT_DIR}/${s}" ]; then
        echo "ERROR: ${SCRIPT_DIR}/${s} is not executable (chmod +x ${SCRIPT_DIR}/${s})"
        preflight_fail=1
    else
        echo "OK: ${SCRIPT_DIR}/${s}"
    fi
done

if [ ${preflight_fail} -ne 0 ]; then
    echo "Pre-flight check failed. Fix the above and run again."
    exit 1
fi

# Step 1: set the status in the control table BEFORE anything starts
#   fresh   : ALL scripts -> W, then every script is run
#   restart : scripts already at S are skipped, the rest -> W and run
# ---------------------------------------------------------------------------
echo "Run mode: ${RUN_MODE}"
TO_RUN=()
for s in "${SCRIPT_LIST[@]}"; do
    if [ "${RUN_MODE}" = "restart" ] && [ "$(get_status "${s}")" = "S" ]; then
        echo "Skipping ${s} - already completed (S)"
    else
        update_status "${s}" "W"
        TO_RUN+=("${s}")
    fi
done

# Step 2: run the stages one by one, in order.
#   - all scripts with the same prefix (e.g. Max1) run in PARALLEL
#   - the next stage starts only after ALL scripts of the stage succeeded
# ---------------------------------------------------------------------------
echo "Plan (scripts of one stage run in PARALLEL, stages run in order):"
seen_keys=" "
stage_no=0
for s in "${SCRIPT_LIST[@]}"; do
    key=${s%%_*}
    case "${seen_keys}" in
        *" ${key} "*) continue ;;
    esac
    seen_keys="${seen_keys}${key} "
    stage_no=$((stage_no+1))
    line=""
    for m in "${SCRIPT_LIST[@]}"; do
        if [ "${m%%_*}" = "${key}" ]; then line="${line} ${m}"; fi
    done
    echo "  Stage ${stage_no} (${key}):${line}"
done

seen_keys=" "
stage_no=0
for s in "${SCRIPT_LIST[@]}"; do
    key=${s%%_*}
    case "${seen_keys}" in
        *" ${key} "*) continue ;;
    esac
    seen_keys="${seen_keys}${key} "
    stage_no=$((stage_no+1))

    # scripts of this stage that still have to run (restart skips the S ones)
    members=()
    for m in "${TO_RUN[@]}"; do
        if [ "${m%%_*}" = "${key}" ]; then members+=("${m}"); fi
    done

    if [ ${#members[@]} -eq 0 ]; then
        echo "=== Stage ${stage_no} (${key}): nothing to run ==="
        continue
    elif [ ${#members[@]} -eq 1 ]; then
        echo "=== Stage ${stage_no} (${key}): running ${members[*]} ==="
        for only in "${members[@]}"; do
            run_script "${only}"
        done
    else
        echo "=== Stage ${stage_no} (${key}): running ${#members[@]} scripts IN PARALLEL: ${members[*]} ==="
        run_parallel "${members[@]}"
    fi
    echo "=== Stage ${stage_no} (${key}) completed ==="
done

echo "=== all process finished ==="

# ---------------------------------------------------------------------------
# Step 3: get processing date from DB
# ---------------------------------------------------------------------------
cmd="
    SET TIMING ON
    SET HEAD OFF FEED OFF PAGES 0
    select to_char(to_date('${BATCH_ID}','YYYYMMDD'),'YYYY-Mon-DD') from dual;"
fnXCmd ${DB_CONN_ID}

# parse the output to get the values
ProcDt=\'$(printf "${output}\n" | head -1)\'

# ---------------------------------------------------------------------------
# Step 4: mail on completion
# ---------------------------------------------------------------------------
mailx -s "maxjob_refresh (${month}) completed successfully !" ${vMailList} <<EOF
Hi,

maxjob_refresh for ${month} has completed successfully.

Batch ID       : ${BATCH_ID}
Refreshed with : ${ProcDt}
Log file       : ${MASTER_LOG}

All scripts finished with status S in ${CTRL_TABLE}.


Best regards,

KPI Support (email - kpi_support@aig.com )

EOF

echo "=== Master Script finished successfully $(date) ==="
exit 0
