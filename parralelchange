#!/usr/bin/zsh
##############################################################################
#
# Script:   AdhocGenerateReportMasterScript
#
# Summary:  Runs the child scripts strictly one-by-one, in the order listed in
#           SCRIPT_LIST, and updates sadb.production_control (PROCESS_STATUS):
#               W = Waiting, R = Running, S = Success, F = Failed
#           On restart it skips scripts already at S for the batch and carries
#           on from the one that failed. Merges the CSVs and mails the report
#           (a failure mail is sent if any script fails).
#
# Run:      nohup ./AdhocGenerateReportMasterScript.sh &
#           nohup ./AdhocGenerateReportMasterScript.sh 20261112 &   (restart a
#                                                       specific batch id)
#
# WHO            WHEN         MODIFICATION HISTORY (most recent first)
#
# <your name>    <dd/mm/yyyy> Initial
# ----------------------------------------------------------------------------
##############################################################################

. ${AIGWRAPPER}/UtilityFuncs
. ${AIGWRAPPER}/XUtilityFuncs

# To generate shell debug info to the console log, uncomment next line
#set -xv

# ---------------------------------------------------------------------------
# nohup-safety: ignore hangup, never wait on a terminal, and do not leave the
# 'no matches' error of zsh when a wildcard matches nothing
# ---------------------------------------------------------------------------
trap '' HUP
trap 'exit 143' TERM INT
setopt NULL_GLOB
exec < /dev/null

# Optional 1st argument = batch id to restart (e.g. ./Master.sh 20261112)
BATCH_ID=${1:-$(date +"%Y%m%d")}
case "${BATCH_ID}" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
    *) echo "ERROR: batch id '${BATCH_ID}' must be YYYYMMDD"; exit 1 ;;
esac

# ---------------------------------------------------------------------------
# Locations (log and output both go to /sawork/sauat/tmp)
# ---------------------------------------------------------------------------
FILE_LOC=/sawork/sauat/tmp
LOG_FILE_LOC=/sawork/sauat/tmp
SCRIPT_DIR=/sawork/sauat/wrapper     # folder where the child scripts are

ProcDate=$(date +"%m%d%Y")
months=(Zero January February March April May June July August September October November December)
curr_month=$(date -d "$(date +%Y-%m-15) -2 month" +%-m)
month=${months[${curr_month}+1]}
OutFileNm=${FILE_LOC}/${month}_KPI_Monthly_refresh_metric_QA_${ProcDate}.csv
vMailList=shashank.jain@aig.com,bipin.pathak@aig.com
#vMailList=shashank.jain@aig.com

mkdir -p ${FILE_LOC} && chmod 755 ${FILE_LOC}
mkdir -p ${LOG_FILE_LOC} && chmod 755 ${LOG_FILE_LOC}

# Everything the master script prints goes to its own log (not nohup.out)
MASTER_LOG=${LOG_FILE_LOC}/AdhocGenerateReportMasterScript_${BATCH_ID}.log
exec >> ${MASTER_LOG} 2>&1

echo "=== Starting Master Script $(date) | batch ${BATCH_ID} ==="

# ---------------------------------------------------------------------------
# Control table settings
#   Table   : sadb.production_control
#   ASSUMED columns: SCRIPT_NAME, BATCH_ID, PROCESS_STATUS, LAST_UPD_TS
#   -> adjust the column names in the SQL below to match your real table.
# ---------------------------------------------------------------------------
CTRL_TABLE="sadb.production_control"
DB_CONN_ID=110          # same id you pass to fnXCmd in the original script

# ---------------------------------------------------------------------------
# Scripts to run - ORDER HERE IS THE ORDER OF EXECUTION. Do not reorder.
# Replace the placeholder names with your real script names.
# ---------------------------------------------------------------------------
SCRIPT_LIST=(
    "Script_Name_1"
    "Script_Name_2"
    "Script_Name_3"
    "Script_Name_4"
    "Script_Name_5"
)

CURRENT_SCRIPT=""       # name of the script that is running right now

# ---------------------------------------------------------------------------
# Update status of a script in the control table
#   usage: update_status <script_name> <W|R|S|F>
# Does an upsert (update if the row exists, insert if not).
# ---------------------------------------------------------------------------
update_status() {
    local sname=$1
    local status=$2

    cmd="
    SET HEAD OFF FEED OFF PAGES 0
    MERGE INTO ${CTRL_TABLE} t
    USING (SELECT '${sname}' AS script_name, '${BATCH_ID}' AS batch_id FROM dual) s
       ON (t.SCRIPT_NAME = s.script_name AND t.BATCH_ID = s.batch_id)
     WHEN MATCHED THEN
          UPDATE SET t.PROCESS_STATUS = '${status}', t.LAST_UPD_TS = SYSDATE
     WHEN NOT MATCHED THEN
          INSERT (SCRIPT_NAME, BATCH_ID, PROCESS_STATUS, LAST_UPD_TS)
          VALUES (s.script_name, s.batch_id, '${status}', SYSDATE);
    COMMIT;"
    fnXCmd ${DB_CONN_ID}

    if [ $? -ne 0 ]; then
        echo "WARNING: could not set ${sname} to ${status} in ${CTRL_TABLE}"
    else
        echo "${CTRL_TABLE}: ${sname} -> ${status}"
    fi
}

# ---------------------------------------------------------------------------
# Read the current status of a script for this batch from the control table
#   usage: get_status <script_name>     (prints W/R/S/F, or N if no row yet)
# ---------------------------------------------------------------------------
get_status() {
    local sname=$1
    cmd="
    SET HEAD OFF FEED OFF PAGES 0
    select nvl(max(PROCESS_STATUS),'N') from ${CTRL_TABLE}
     where SCRIPT_NAME = '${sname}' and BATCH_ID = '${BATCH_ID}';"
    fnXCmd ${DB_CONN_ID}
    printf "%s\n" "${output}" | grep -E '^[A-Z]$' | head -1
}

# ---------------------------------------------------------------------------
# Send a failure mail (with the failed script's log attached)
#   usage: send_failure_mail <script_name> <return_code>
# ---------------------------------------------------------------------------
send_failure_mail() {
    local sname=$1
    local rcode=$2
    local logf=${LOG_FILE_LOC}/${sname}.log

    if [ -f ${logf} ]; then
        mailx -s "FAILED: ${month} monthly report - ${sname} failed !" -a ${logf} ${vMailList} <<EOF
Hi,

The ${month} monthly report job has FAILED.

Failed script : ${sname}
Return code   : ${rcode}
Batch ID      : ${BATCH_ID}
Log file      : ${logf} (attached)

The master script has stopped. Remaining scripts were not run and are
still marked W in ${CTRL_TABLE}. Fix the problem and run the master script
again (batch ${BATCH_ID}); it will continue from ${sname}.


Best regards,

KPI Support (email - kpi_support@aig.com )

EOF
    else
        mailx -s "FAILED: ${month} monthly report - ${sname} failed !" ${vMailList} <<EOF
Hi,

The ${month} monthly report job has FAILED.

Failed script : ${sname}
Return code   : ${rcode}
Batch ID      : ${BATCH_ID}
Log file      : not found at ${logf}

The master script has stopped. Remaining scripts were not run and are
still marked W in ${CTRL_TABLE}. Fix the problem and run the master script
again (batch ${BATCH_ID}); it will continue from ${sname}.


Best regards,

KPI Support (email - kpi_support@aig.com )

EOF
    fi
}

# ---------------------------------------------------------------------------
# If the master script is killed (kill / TERM / INT) while a child script is
# running, mark that script as F so the table does not stay at R.
# ---------------------------------------------------------------------------
on_exit() {
    if [ -n "${CURRENT_SCRIPT}" ]; then
        echo "Master script terminated while ${CURRENT_SCRIPT} was running"
        update_status "${CURRENT_SCRIPT}" "F"
        CURRENT_SCRIPT=""
    fi
}
trap on_exit EXIT

# ---------------------------------------------------------------------------
# Run one script and wait for it to finish (foreground, so the next
# script cannot start until this one has completed)
# ---------------------------------------------------------------------------
run_script() {
    local script_name=$1
    local rc

    update_status "${script_name}" "R"
    CURRENT_SCRIPT="${script_name}"
    echo ">>> Starting ${script_name}... $(date)"

    "${SCRIPT_DIR}/${script_name}" < /dev/null > ${LOG_FILE_LOC}/${script_name}.log 2>&1
    rc=$?        # capture the exit code immediately
    CURRENT_SCRIPT=""

    # move any log the script wrote in its own folder
    if [ -f ${SCRIPT_DIR}/${script_name}.log ]; then
        mv -f ${SCRIPT_DIR}/${script_name}.log ${LOG_FILE_LOC}/${script_name}.wrapper.log
    fi

    if [ ${rc} -ne 0 ]; then
        update_status "${script_name}" "F"
        echo "${script_name} failed (rc=${rc}). Check ${LOG_FILE_LOC}/${script_name}.log"
        echo "Stopping master script."
        send_failure_mail "${script_name}" "${rc}"
        exit 1
    fi

    update_status "${script_name}" "S"
    echo "${script_name} completed successfully. $(date)"
}

# ---------------------------------------------------------------------------
# Step 0: pre-flight check. Before anything runs, confirm the scripts folder
#         exists and EVERY script in SCRIPT_LIST is there and executable.
#         Nothing is started (and the control table is untouched) if any fails.
# ---------------------------------------------------------------------------
echo "Scripts location: ${SCRIPT_DIR}"
if [ ! -d "${SCRIPT_DIR}" ]; then
    echo "ERROR: scripts folder ${SCRIPT_DIR} does not exist"
    exit 1
fi
cd ${SCRIPT_DIR} || { echo "ERROR: cannot cd to ${SCRIPT_DIR}"; exit 1; }

preflight_fail=0
for s in "${SCRIPT_LIST[@]}"; do
    if [ ! -f "${SCRIPT_DIR}/${s}" ]; then
        echo "ERROR: ${SCRIPT_DIR}/${s} not found"
        preflight_fail=1
    elif [ ! -x "${SCRIPT_DIR}/${s}" ]; then
        echo "ERROR: ${SCRIPT_DIR}/${s} is not executable (chmod +x ${SCRIPT_DIR}/${s})"
        preflight_fail=1
    else
        echo "OK: ${SCRIPT_DIR}/${s}"
    fi
done

if [ ${preflight_fail} -ne 0 ]; then
    echo "Pre-flight check failed. Fix the above and run again."
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 1: restart logic. Scripts already marked S for this BATCH_ID are skipped,
#         everything else (W, R, F or no row) is set to W and will be run, in
#         the original order. So a restart continues from the script that failed.
# ---------------------------------------------------------------------------
TO_RUN=()
for s in "${SCRIPT_LIST[@]}"; do
    st=$(get_status "${s}")
    if [ "${st}" = "S" ]; then
        echo "Skipping ${s} - already completed (S) for batch ${BATCH_ID}"
    else
        update_status "${s}" "W"
        TO_RUN+=("${s}")
    fi
done

# ---------------------------------------------------------------------------
# Step 2: run the remaining scripts one by one, in the listed order
# ---------------------------------------------------------------------------
for s in "${TO_RUN[@]}"; do
    run_script "${s}"
done

echo "=== all process finished ==="

# ---------------------------------------------------------------------------
# Step 3: merge all CSVs into one output file
# ---------------------------------------------------------------------------
: > ${OutFileNm}

for file in ${FILE_LOC}/*.csv; do
    # skip the merged output file itself
    [ "${file}" = "${OutFileNm}" ] && continue
    if [ -f ${file} ]; then
        echo "Merging: ${file}"
        echo "### File: $(basename "${file}") ###" >> ${OutFileNm}
        echo "" >> ${OutFileNm}
        cat ${file} >> ${OutFileNm}
        echo "" >> ${OutFileNm}
        echo "" >> ${OutFileNm}
    fi
done
echo "${ProcDate} all file merged into ${OutFileNm}"

# ---------------------------------------------------------------------------
# Step 4: get processing date from DB
# ---------------------------------------------------------------------------
cmd="
    SET TIMING ON
    SET HEAD OFF FEED OFF PAGES 0
    select to_char(to_date('${BATCH_ID}','YYYYMMDD'),'YYYY-Mon-DD') from dual;"
fnXCmd ${DB_CONN_ID}

# parse the output to get the values
ProcDt=\'$(printf "${output}\n" | head -1)\'

# ---------------------------------------------------------------------------
# Step 5: mail the merged file
# ---------------------------------------------------------------------------
mailx -s "${month} monthly report is generated !" -a ${OutFileNm} ${vMailList} <<EOF
Hi,

"${month} Monthly report refresh metric" is generated.

File $(basename "${OutFileNm}") is refreshed with ${ProcDt} and available in the attachment.


Best regards,

KPI Support (email - kpi_support@aig.com )

EOF

echo "=== Master Script finished successfully $(date) ==="
exit 0
